# ── Database (same MariaDB as the Dart backend) ──────────────────
# On Railway: reference the MariaDB service variables
# DB_HOST=${{mariadb.MYSQLHOST}}
DB_HOST=acela.proxy.rlwy.net
DB_PORT=29351
DB_USER=root
DB_PASSWORD=your_mariadb_password
DB_NAME=nepstyle

# ── Qdrant Cloud ─────────────────────────────────────────────────
# Create a free cluster at https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=nepstyle_products

# ── Google Gemini ─────────────────────────────────────────────────
# Get free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ── AI Service Auth ──────────────────────────────────────────────
# Shared secret — set as VITE_AI_API_KEY in Vercel for the frontend
AI_API_KEY=change_me_to_a_random_secret_key

# ── Dart backend base URL (AI service calls it for auth validation) ─
DART_BACKEND_URL=https://your-dart-backend.up.railway.app
